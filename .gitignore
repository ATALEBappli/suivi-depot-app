# Liaisons Google et authentification locales : jamais versionnées.
.clasp.json
.clasp.*.json
.clasprc.json
.clasprc.*.json
.env
.env.*
!.env.example
credentials.json
client_secret*.json
*service-account*.json
# Exports privés, sauvegardes et fichiers de travail.
work/

# Frontend généré : configuration injectée hors Git.
dist/

# Assets REC générés depuis le commit frontend approuvé, jamais de secrets.
rec-server/public/

# Workers : artefacts, sessions locales et secrets hors Git.
rec-worker/node_modules/
rec-worker/.wrangler/
rec-worker/.dev.vars*
rec-worker/generated-manifest.mjs
